# Clave privada de la wallet que despliega (SIN el 0x opcional, tal cual la exporta MetaMask)
# NUNCA compartas esta clave ni la subas a un repositorio.
PRIVATE_KEY=

# RPC público de Sepolia (opcional; por defecto usa publicnode.com sin API key)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# API key de Etherscan (gratis en https://etherscan.io/apis) — solo para verificar el contrato
ETHERSCAN_API_KEY=
