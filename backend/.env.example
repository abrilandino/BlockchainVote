# Puerto del servidor Backend
PORT=4000

# Entorno (production en despliegue real)
NODE_ENV=development

# Clave secreta para JWT — MÍNIMO 32 caracteres (256 bits)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG!

# Cadena de bloques objetivo
RPC_URL=http://127.0.0.1:8545

# Dirección del contrato desplegado (se actualiza tras deploy)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Clave privada del wallet administrador (solo testing/local)
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000
